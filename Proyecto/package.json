{
  "name": "odinote",
  "version": "1.0.2",
  "description": "Tu mente, ordenada en canvases anidados libres e infinitos.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-packager . Odinote --platform=win32 --arch=x64 --out=dist --overwrite --icon=Icon/Icon.ico",
    "build:installer": "node build-installer.js"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "build": {
    "appId": "com.odinote.app",
    "productName": "Odinote",
    "directories": {
      "output": "dist/installer"
    },
    "win": {
      "icon": "Icon/Icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Odinote"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/electron",
      "!node_modules/electron-packager",
      "!node_modules/electron-builder"
    ]
  }
}
