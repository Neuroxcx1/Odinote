rules_version = '2';

// Oddinote — reglas de Firestore.
// Se pegan enteras en la consola de Firebase: Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo cerrado, salvo lo de abajo.
    match /{document=**} {
      allow read, write: if false;
    }

    // Sesiones en vivo: el código es la llave. Se puede abrir una sala sabiendo
    // su código, pero nadie puede pedir la lista.
    match /salas/{codigo} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && codigo.size() >= 6 && codigo.size() <= 32
        && request.resource.data.keys().hasOnly(['anfitrion', 'creadaEn', 'expiraEn', 'version'])
        && request.resource.data.anfitrion == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.anfitrion == request.auth.uid;

      match /senales/{id} {
        allow get, list: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.de == request.auth.uid
          && request.resource.data.keys().hasOnly(['de', 'para', 'tipo', 'carga', 'creadaEn', 'expiraEn'])
          && request.resource.data.tipo in ['oferta', 'respuesta', 'candidato']
          && request.resource.data.carga is string
          && request.resource.data.carga.size() < 8000;
        allow delete: if request.auth != null
          && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      }
    }

    // Enlace para ver: lo lee cualquiera que tenga el enlace (también sin
    // cuenta), nadie puede listarlos, y solo el dueño lo crea, cambia o borra.
    match /vistas/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && id.size() >= 16 && id.size() <= 40
        && request.resource.data.dueno == request.auth.uid
        && request.resource.data.keys().hasOnly(['dueno', 'raiz', 'nombre', 'emoji', 'lienzos', 'actualizadoEn', 'version']);
      allow update: if request.auth != null
        && resource.data.dueno == request.auth.uid
        && request.resource.data.dueno == resource.data.dueno
        && request.resource.data.keys().hasOnly(['dueno', 'raiz', 'nombre', 'emoji', 'lienzos', 'actualizadoEn', 'version']);
      allow delete: if request.auth != null
        && resource.data.dueno == request.auth.uid;
    }

    // La corona: cada uno lee lo suyo y nada más. Escribe solo la función de
    // Ko-fi (functions/index.js), que no pasa por estas reglas.
    match /patrocinadores/{correo} {
      allow get: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == correo;
      allow list: if false;
      allow write: if false;
    }
  }
}
