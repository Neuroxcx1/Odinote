{
  "name": "odinote",
  "version": "1.0.4",
  "description": "Tu mente, ordenada en canvases anidados libres e infinitos.",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "build:exe": "electron-packager . Odinote --platform=win32 --arch=x64 --out=dist --overwrite --icon=Icon/Icon.ico",
    "build:installer": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "build": {
    "appId": "com.odinote.app",
    "productName": "Odinote",
    "asar": false,
    "directories": {
      "output": "dist/nsis-builder"
    },
    "win": {
      "icon": "Icon/Icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Odinote",
      "license": "LICENSE"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "LICENSE",
      "Icon/**/*",
      "lib/**/*",
      "src/**/*"
    ]
  }
}
