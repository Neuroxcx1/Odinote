{
  "name": "odinote",
  "version": "1.0.8",
  "description": "Tu mente, ordenada en canvases anidados libres e infinitos.",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "dev:web": "node dev-server.js",
    "test:drive": "node scripts/test-drive.js && node scripts/test-oauth.js && node scripts/test-todo.js && node scripts/test-connector.js",
    "test:search": "node scripts/test-search.js",
    "test:links": "node scripts/test-links.js",
    "test:graph": "node scripts/test-graph.js",
    "test": "node scripts/test-search.js && node scripts/test-links.js && node scripts/test-graph.js && node scripts/test-draw.js && node scripts/test-sync.js && node scripts/test-sala.js && node scripts/test-nube.js && node scripts/test-drive.js && node scripts/test-oauth.js && node scripts/test-todo.js && node scripts/test-connector.js && node scripts/test-patrocinio.js && node scripts/test-reclamacion.js && node scripts/test-boveda.js && node scripts/test-tiempo.js && node scripts/test-calendario.js && node scripts/test-paleta.js && node scripts/test-carpetas.js",
    "build:pre": "node scripts/build-pre.js",
    "build:exe": "electron-packager . Odinote --platform=win32 --arch=x64 --out=dist --overwrite --icon=Icon/Icon.ico && node scripts/build-zip.js",
    "build:exe-only": "electron-packager . Odinote --platform=win32 --arch=x64 --out=dist --overwrite --icon=Icon/Icon.ico",
    "build:installer": "electron-builder --win --x64",
    "test:draw": "node scripts/test-draw.js",
    "test:sync": "node scripts/test-sync.js",
    "test:sala": "node scripts/test-sala.js",
    "test:nube": "node scripts/test-nube.js",
    "test:patrocinio": "node scripts/test-patrocinio.js",
    "test:reclamacion": "node scripts/test-reclamacion.js",
    "test:boveda": "node scripts/test-boveda.js",
    "test:tiempo": "node scripts/test-tiempo.js",
    "test:calendario": "node scripts/test-calendario.js",
    "test:paleta": "node scripts/test-paleta.js",
    "test:carpetas": "node scripts/test-carpetas.js"
  },
  "devDependencies": {
    "archiver": "^5.3.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0"
  },
  "build": {
    "appId": "com.odinote.app",
    "productName": "Odinote",
    "asar": false,
    "directories": {
      "output": "dist/nsis-builder"
    },
    "win": {
      "icon": "Icon/Icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Odinote",
      "license": "LICENSE"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "LICENSE",
      "Icon/**/*",
      "lib/**/*",
      "src/**/*"
    ]
  }
}
